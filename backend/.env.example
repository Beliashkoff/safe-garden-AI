# === Окружение ===
ENV=dev

# === HTTP ===
HTTP_HOST=
HTTP_PORT=8080

# === Логи ===
# debug | info | warn | error
LOG_LEVEL=info

# === Sentry (опционально) ===
# При пустом значении Sentry не инициализируется.
SENTRY_DSN=

# ============================================================================
# Ниже — placeholder'ы под ключи Этапа 0.6 (внешние аккаунты заказчика).
# Некоторые активированы на Этапе 1.1 (auth-фундамент), остальные —
# закомментированы до соответствующего этапа.
# Подробный runbook по получению — в README.md, раздел
# «Регистрация внешних аккаунтов».
#
# Секреты никогда не коммитим. Хранение — в password manager заказчика
# (1Password / Bitwarden / Yandex Vault) и в Yandex Lockbox в prod.
# ============================================================================

# === Postgres (Этап 1.1) ===
POSTGRES_DSN=postgres://safegarden:safegarden@localhost:5432/safegarden?sslmode=disable

# === JWT (Этап 1.1) ===
# Мульти-ключевая ротация (рекомендуется): директория с PEM-файлами
# вида <kid>.pem (PKCS#8 RSA private). На подпись идёт ключ JWT_ACTIVE_KID;
# все ключи в директории доступны для verify (grace-период ≈ access TTL).
JWT_KEYS_DIR=./dev-keys
JWT_ACTIVE_KID=dev1
# Альтернатива (упрощённый dev-вариант, один ключ):
# JWT_PRIVATE_KEY_PATH=/secrets/jwt-rs256.pem
# JWT_KID=2026-05
# Время жизни access/refresh — переопределяется только если нужно отойти
# от ARCHITECTURE §8.1 (15m / 30d).
# JWT_ACCESS_TTL=15m
# REFRESH_TTL=720h

# === OAuth: Яндекс ID (406-ФЗ: только российские провайдеры) ===
# Регистрация приложения — https://oauth.yandex.ru (права: login:info, login:email).
# ClientID/Client secret из карточки приложения. Redirect URI должен в точности
# совпадать с Callback URI в настройках приложения; мобильное приложение ловит
# его в системном браузере (custom scheme). Обмен кода и проверка identity-JWT
# (HS256 на client_secret) выполняются только на бэкенде.
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
YANDEX_REDIRECT_URI=safegarden://auth/yandex

# === OAuth: VK ID ===
# Кабинет — https://id.vk.ru/about/business (нужен VK Business ID + ИНН).
# VK_CLIENT_ID — числовой ID приложения. Секрет НЕ нужен бэкенду: мобильный
# SDK — публичный клиент, обмен кода защищён PKCE (verifier живёт на бэке).
# VK_REDIRECT_URI — deep link SDK: vk{client_id}://vk.ru.
VK_CLIENT_ID=
VK_REDIRECT_URI=

# === Redis (Этап 2.3) ===
# Per-user rate limit на POST /v1/messages (20 RPS, ARCH §8.2). В dev — redis из
# docker-compose; пусто → rate limit отключён (allow-all). В prod обязателен.
REDIS_ADDR=localhost:6379
# REDIS_PASSWORD=

# === UID hash pepper (Этап 2.3) ===
# Соль для uid_hash = sha256(user_id + pepper) — единственный идентификатор
# пользователя, уходящий в worker/Anthropic (ARCH §11.4, §8.6). Обязателен в prod.
# Совпадает с UID_HASH_PEPPER в env worker'а.
UID_HASH_PEPPER=dev-pepper-change-me

# === Object Storage (Этап 3.1) ===
# В dev — MinIO (см. docker-compose.yml: minioadmin / minioadmin). Bucket нужно
# создать один раз (mc mb / консоль http://localhost:9001). Пусто → presign
# и фото в чате отключены. В prod — Yandex Object Storage, креды из Yandex Cloud
# service account; обязательны (S3_ENDPOINT/S3_ACCESS_KEY/S3_SECRET_KEY/S3_BUCKET).
S3_ENDPOINT=http://localhost:9000
S3_REGION=ru-central1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=safe-garden-dev-media
# Path-style адресация (true для MinIO и Yandex OS). Virtual-host — false.
S3_USE_PATH_STYLE=true

# === SMTP — Mailer для OTP (Этап 1.2) ===
# Dev по умолчанию шлёт в MailHog из docker-compose (localhost:1025, без auth
# и TLS) — письма видны в http://localhost:8025. Значения ниже переопределять
# в dev не нужно; они показаны для наглядности.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=noreply@localhost
SMTP_FROM_NAME=Safe Garden AI
SMTP_TLS=false
# SMTP_USERNAME=
# SMTP_PASSWORD=
#
# Prod — Yandex 360. Хост/порт фиксированы; SMTP_TLS=true (implicit TLS на 465).
# Username — почтовый адрес; password — пароль приложения из настроек ящика,
# не основной пароль. SMTP_USERNAME/SMTP_PASSWORD/SMTP_FROM обязательны в prod.
# SMTP_HOST=smtp.yandex.ru
# SMTP_PORT=465
# SMTP_TLS=true
# SMTP_USERNAME=noreply@agronomai.site
# SMTP_PASSWORD=
# SMTP_FROM=noreply@agronomai.site

# === Swagger UI / OpenAPI (Этап 1.2) ===
# Отдаёт спецификацию и Swagger UI на /v1/docs. Можно выключить в prod.
DOCS_ENABLED=true

# === Админ-панель (Этап 6.x) ===
# ADMIN_EMAIL — единственный аккаунт оператора. На этот адрес (и только на него)
# уходят коды первичной настройки и восстановления пароля; вход тоже разрешён
# только под ним. Пусто → админ-панель отключена (роуты /admin/* не монтируются),
# api стартует как обычно. Прод: agronomai@yandex.com.
ADMIN_EMAIL=
# Sliding-TTL сессии оператора (активность продлевает).
# ADMIN_SESSION_TTL=24h
# Ожидаемый Origin мутирующих запросов (защита от cross-site). В prod —
# https://admin.agronomai.site; пусто → проверка отключена (dev).
# ADMIN_ALLOWED_ORIGIN=
#
# ВАЖНО (prod): админ-почта работает через тот же SMTP (Yandex 360), что и OTP.
# Восстановление пароля админки требует рабочего SMTP_USERNAME/PASSWORD.

# === LLM-клиент (Этап 0.7+) ===
# Выбор реализации llm.Client:
#   - mock   — фикстуры из internal/llm/mock_client.go (по умолчанию в dev/тестах)
#   - worker — реальный HTTP+SSE к llm-worker'у через mTLS (prod)
LLM_CLIENT_KIND=mock

# === LLM-worker (Этап 2.2) ===
# Используется, когда LLM_CLIENT_KIND=worker. ANTHROPIC_API_KEY и
# UID_HASH_PEPPER сюда НЕ кладём — они переменные worker'а
# (`internal/llmworker/`, см. backend/.env.worker.example). CLAUDE.md инвариант №5.
# LLM_WORKER_BASE_URL=https://worker.agronomai.site
# LLM_WORKER_MTLS_ENABLED=true
# LLM_WORKER_CA_PATH=/secrets/mtls/ca.pem
# LLM_WORKER_CLIENT_CERT_PATH=/secrets/mtls/api-client.crt
# LLM_WORKER_CLIENT_KEY_PATH=/secrets/mtls/api-client.key

# === Транскрипция / STT — голосовые сообщения (Этап 4.2) ===
# Провайдер распознавания речи:
#   - mock      — фикстура (по умолчанию в dev/тестах). ВНИМАНИЕ: в prod при
#                 mock голос вернёт фейковый текст, а не ошибку.
#   - speechkit — Yandex SpeechKit v3 (gRPC streaming), prod
#   - gigachat  — резерв (Sber SaluteSpeech), не реализован
STT_PROVIDER_KIND=mock
# Язык распознавания (single-entry whitelist). Для целевой аудитории — ru-RU.
STT_LANGUAGE=ru-RU
#
# --- SpeechKit (обязательно при STT_PROVIDER_KIND=speechkit) ---
# API-ключ сервис-аккаунта с ролью ai.speechkit-stt.user (Yandex Cloud).
# Имя переменной — именно SPEECHKIT_API_KEY (НЕ YANDEX_SPEECHKIT_API_KEY).
# При Kind=speechkit пустой ключ → бэкенд не стартует (audio.LoadConfig).
# SPEECHKIT_API_KEY=
# Эндпоинт v3 — дефолт верный, менять не нужно.
# SPEECHKIT_ENDPOINT=stt.api.cloud.yandex.net:443
# Folder ID — обычно пусто: API-ключ сервис-аккаунта уже подразумевает каталог.
# Задавать только при IAM-token авторизации.
# SPEECHKIT_FOLDER_ID=
# Модель распознавания.
# SPEECHKIT_MODEL=general
#
# ffmpeg/ffprobe для конвертации m4a/aac → OggOpus (есть в Docker-образе api).
# FFMPEG_PATH=ffmpeg
# FFPROBE_PATH=ffprobe
#
# --- GigaChat (резерв, не используется) ---
# GIGACHAT_API_KEY=
# GIGACHAT_SCOPE=
