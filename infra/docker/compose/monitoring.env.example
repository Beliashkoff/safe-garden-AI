# Скопировать в /etc/safegarden/monitoring.env на API-VM (не коммитим).
# Передаётся в compose:
#   docker compose -f monitoring.yml --env-file /etc/safegarden/monitoring.env up -d
#
# Дополнительно (не env, а файлы-секреты на VM, chmod 600):
#   /etc/safegarden/monitoring/secrets/smtp_password  — пароль приложения Yandex 360
#       (тот же, что SMTP_PASSWORD у api; для email-алертов Alertmanager)

# Пароль администратора Grafana (ОБЯЗАТЕЛЕН). Grafana на 127.0.0.1:3000,
# доступ через SSH-туннель: ssh -L 3000:localhost:3000 safegarden@<api-vm>
GRAFANA_ADMIN_PASSWORD=change-me

# DSN для postgres-exporter — ТОЛЬКО если запускаешь профиль "pg"
# (docker compose --profile pg ...). Отдельная read-only роль monitoring
# (член pg_monitor), НЕ прод-DSN. По умолчанию exporter выключен — метрики БД
# доступны в нативном мониторинге Yandex Cloud.
# PG_EXPORTER_DSN=postgres://monitoring:PASSWORD@HOST:6432/safegarden?sslmode=verify-full
